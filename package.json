{
  "name": "meme-slot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "contracts:test": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "deploy:robinhood:testnet": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:robinhood": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network robinhood",
    "deploy:token-launcher:robinhood": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy-token-launcher.ts --network robinhood",
    "verify:robinhood:testnet": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat verify --network robinhoodTestnet",
    "verify:robinhood": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat verify --network robinhood"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@openzeppelin/contracts": "5.1.0",
    "@rainbow-me/rainbowkit": "2.2.2",
    "@tanstack/react-query": "5.62.8",
    "@vercel/blob": "^2.0.0",
    "framer-motion": "^11.11.17",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "undici": "^8.11.2",
    "viem": "2.21.55",
    "wagmi": "2.14.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "hardhat": "^2.29.1",
    "pino-pretty": "13.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
