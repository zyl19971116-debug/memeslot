# Copy this file to .env.local and fill in your key.
#
# FAL_KEY accepts either:
#   - a fal.ai key (https://fal.ai/dashboard/keys), or
#   - a QuickRouter key (sk-..., https://api.quickrouter.ai/console)
#     which automatically routes through the OpenAI-compatible relay.
FAL_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_URL=
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_MEME_SLOT_CONTRACT_ADDRESS=
